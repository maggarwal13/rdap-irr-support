          "comments": [
            {
              "originalPosition": 527,
              "body": "I agree, we have rdapConformances like rirSearch1 , autnums etc...\r\nI can change it to irr0 to be consistent ",
              "createdAt": "2025-11-24T15:18:29Z",
              "updatedAt": "2025-11-24T15:18:29Z"
            }
          ]
        },
        {
          "id": "PRR_kwDOQa7tLM7QrLxV",
          "commit": {
            "abbreviatedOid": "665d301"
          },
          "author": "maggarwal13",
