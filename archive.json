          "comments": [
            {
              "originalPosition": 109,
              "body": "Should there be a \"/\" between the route and origin portions of this lookup path segment? That could help with parsing (particularly the CIDR length) in case needed on the client side.",
              "createdAt": "2025-11-24T18:35:36Z",
              "updatedAt": "2025-11-24T19:02:52Z"
