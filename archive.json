          "comments": [
            {
              "originalPosition": 113,
              "body": "In addition to prefixing new JSON members and object class names with the extension id, the new path segments should also be prefixed. E.g., \"route\" -> \"irr0_route\".\r\n\r\nAlso, good to URL-encode reserved characters like \":\" in the examples for the new path segments.",
              "createdAt": "2025-11-24T18:31:05Z",
              "updatedAt": "2025-11-24T19:21:34Z"
            }
          ]
        },
        {
          "id": "PRR_kwDOQa7tLM7QuBor",
          "commit": {
            "abbreviatedOid": "503b9c0"
          },
