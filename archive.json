          "comments": [
            {
              "originalPosition": 120,
              "body": "To help map better to the RPSL, should \"prefix\" not be called \"route\"? IMO, good to do so for RPSL-related JSON members, for ease of comprehension.",
              "createdAt": "2025-11-24T18:37:30Z",
              "updatedAt": "2025-11-24T19:04:33Z"
