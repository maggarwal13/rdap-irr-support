          "comments": [
            {
              "originalPosition": 80,
              "body": "\"protocol\" -> \"specification\" ... something the IESG flagged for more recent RDAP extensions.",
              "createdAt": "2025-11-24T18:28:23Z",
              "updatedAt": "2025-11-24T19:01:41Z"
