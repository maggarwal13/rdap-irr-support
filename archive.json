          "comments": [
            {
              "originalPosition": 156,
              "body": "Would be good to point to the section from RFC 2622 for this field. Similarly, for other fields where we say \"as specified by RPSL\". Since this is intended as a standards-track specification, more precise references should help the implementors.",
              "createdAt": "2025-11-24T18:45:02Z",
