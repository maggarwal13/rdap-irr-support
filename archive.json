      "authorAssociation": "OWNER",
      "assignees": [],
      "labels": [],
      "body": "The core specifications for RDAP defines core object types, but it does\r\nnot contain objects for Internet Routing Registries (IRRs). This document is\r\nintended to address this gap.",
      "createdAt": "2025-11-24T11:24:50Z",
      "updatedAt": "2025-11-24T19:34:37Z",
      "baseRepository": "maggarwal13/rdap-irr-support",
      "baseRefName": "main",
      "baseRefOid": "46c059c16e3d387d8a6494c6a287d75a8b28f8d3",
      "headRepository": "maggarwal13/rdap-irr-support",
      "headRefName": "rdap_irr_support",
      "headRefOid": "503b9c066ebdbcfcd09a8a82d85b96dc8b68c61b",
      "closedAt": null,
      "mergedAt": null,
      "mergedBy": null,
      "mergeCommit": null,
      "comments": [],
