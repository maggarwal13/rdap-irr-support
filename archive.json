          "comments": [
            {
              "originalPosition": 66,
              "body": "It might help the cause to have a stronger rationale about why having the IRR registered data in RDAP would be useful. Is it because the registries are in general moving away from Whois to RDAP? Or, is there a more specific value-add?",
              "createdAt": "2025-11-24T18:27:38Z",
              "updatedAt": "2025-11-24T19:01:08Z"
            }
          ]
